{
  "expo": {
    "name": "Nutrimap",
    "slug": "Nutrimap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nutrimap-logo.png",
    "scheme": "nutrimap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Nutrimap to use your location."
      }
    },
    "android": {
      "package": "com.nutrimap",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/nutrimap-icon-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDXDigpAflVjw4yFlzwJ8y9ZcgeKQ1ITSk"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nutrimap-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nutrimap-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Nutrimap to use your location."
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "NEVER"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61d7e134-bd19-4215-882e-d172e59bcad8"
      }
    }
  }
}
